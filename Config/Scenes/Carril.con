# Escena del carril (Carrera Individual, Copa NAO CCM MX 2026).
call Includes/Normal

# Sin marcador ni reloj de juego: en la carrera no hay goles ni tiempo de partido.
dr debugDrawing3d:representation:GameState off

call Includes/Views

# Sin árbitro automático: penalizaría al robot por la disposición del carril.
ar off

# Recolocar al robot en la salida: asienta la física y hace que la pose real
# (GroundTruthWorldState) se publique sin el espejo por lado de equipo.
mv -2200 0 320 0 0 0

# Dejar que el robot se asiente en pie (~8 s: cada get espera un frame de la cámara
# inferior) y empezar la carrera, como el segundo toque al pecho en el robot real.
# A mano: Shift+Ctrl+P = playing (correr), Shift+Ctrl+M = penalización manual (PARO),
# Shift+Ctrl+U = quitar penalización (nueva carrera desde donde esté).
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
for Lower get representation:FrameInfo
