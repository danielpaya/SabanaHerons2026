<Simulation>

  <Include href="Includes/NaoV6H25.rsi2"/>
  <Include href="Includes/Carril/carril.rsi2"/>

  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)" ERP="0.8" CFM="0.001" contactSoftERP="0.2" contactSoftCFM="0.005">
    <!-- Luz direccional cenital: iluminación uniforme en todo el carril. Con una
         PointLight única en el centro, la duela de los extremos se renderiza casi
         negra y la visión pierde el contraste (y con varias, se quema). -->
    <DirLight z="-1" diffuseColor="rgb(45%, 45%, 45%)" ambientColor="rgb(45%, 45%, 45%)"/>

    <Compound name="teams">
      <Compound name="Herons">
        <Compound name="24"/>
        <Compound name="black"/>
        <Compound name="black"/>
      </Compound>
      <Compound name="Opponents">
        <Compound name="70"/>
        <Compound name="red"/>
        <Compound name="blue"/>
      </Compound>
    </Compound>

    <Compound name="location">
      <Compound name="Default"/>
    </Compound>

    <Compound name="scenarios">
      <Compound name="Carril"/>
    </Compound>

    <Compound ref="carrilRobots" name="robots"/>

    <Compound name="extras"/>

    <Compound ref="carrilFloor"/>
    <Compound ref="carril"/>
  </Scene>
</Simulation>
